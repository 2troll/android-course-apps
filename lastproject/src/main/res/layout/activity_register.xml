<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/wallpaper1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="30sp"
        android:textColor="#c5c6c7"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20sp"
        android:text="@string/sign_up"/>
    <ImageView
        android:id="@+id/choosePhoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp"
        app:srcCompat="@drawable/login"/>
    <TextView
        android:textColor="#c5c6c7"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5sp"
        android:layout_marginBottom="30sp"
        android:text="@string/sign_up_and_find_your_products"/>
    <EditText
        android:textSize="15sp"
        android:textColorHint="@color/black"
        android:id="@+id/registerFName"
        android:background="@drawable/edittext_custom"
        android:padding="5sp"
        android:layout_width="match_parent"
        android:layout_height="35sp"
        android:layout_marginLeft="20sp"
        android:layout_marginRight="20sp"
        android:hint="@string/first_name"
        android:drawablePadding="10sp"
        android:drawableStart="@drawable/account_icon"/>
    <EditText
        android:textSize="15sp"
        android:textColorHint="@color/black"
        android:id="@+id/registerUserName"
        android:background="@drawable/edittext_custom"
        android:padding="5sp"
        android:layout_width="match_parent"
        android:layout_height="35sp"
        android:layout_marginLeft="20sp"
        android:layout_marginTop="20sp"
        android:layout_marginRight="20sp"
        android:hint="@string/username"
        android:drawablePadding="10sp"
        android:drawableStart="@drawable/username_icon"/>
    <EditText
        android:textSize="15sp"
        android:textColorHint="@color/black"
        android:id="@+id/registerEmail"
        android:background="@drawable/edittext_custom"
        android:padding="5sp"
        android:layout_width="match_parent"
        android:layout_height="35sp"
        android:layout_marginLeft="20sp"
        android:layout_marginTop="20sp"
        android:layout_marginRight="20sp"
        android:hint="@string/email"
        android:drawablePadding="10sp"
        android:drawableStart="@drawable/email_icon"/>
    <EditText
        android:textSize="15sp"
        android:textColorHint="@color/black"
        android:id="@+id/registerPassword"
        android:background="@drawable/edittext_custom"
        android:padding="5sp"
        android:layout_width="match_parent"
        android:layout_height="35sp"
        android:layout_marginLeft="20sp"
        android:layout_marginTop="20sp"
        android:layout_marginRight="20sp"
        android:hint="@string/password"
        android:drawablePadding="10sp"
        android:inputType="textPassword"
        android:drawableStart="@drawable/lock_icon"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2">
        <EditText
            android:textSize="15sp"
            android:textColorHint="@color/black"
            android:id="@+id/registerDate"
            android:background="@drawable/edittext_custom"
            android:padding="5sp"
            android:layout_width="170sp"
            android:layout_height="35sp"
            android:layout_marginLeft="20sp"
            android:layout_marginTop="20sp"
            android:layout_marginRight="20sp"
            android:hint="@string/date"
            android:drawablePadding="10sp"
            android:layout_weight="1.7"
            android:drawableStart="@drawable/date_icon"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/white"
            android:id="@+id/register_select_date"
            android:background="@drawable/btn_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:text="@string/select_date"
            android:textAllCaps="false"/>
    </LinearLayout>
    <EditText
        android:textSize="15sp"
        android:textColorHint="@color/black"
        android:id="@+id/registerPhoneNumber"
        android:background="@drawable/edittext_custom"
        android:padding="5sp"
        android:layout_width="match_parent"
        android:layout_height="35sp"
        android:layout_marginLeft="20sp"
        android:layout_marginTop="20sp"
        android:layout_marginRight="20sp"
        android:hint="@string/phone_number"
        android:drawablePadding="10sp"
        android:inputType="number"
        android:drawableStart="@drawable/phone_icon"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2">
        <EditText
            android:textSize="15sp"
            android:textColorHint="@color/black"
            android:id="@+id/registerGender"
            android:background="@drawable/edittext_custom"
            android:padding="5sp"
            android:layout_width="170sp"
            android:layout_height="35sp"
            android:layout_marginLeft="20sp"
            android:layout_marginTop="20sp"
            android:layout_marginRight="20sp"
            android:hint="@string/gender"
            android:drawablePadding="10sp"
            android:layout_weight="1.7"
            android:drawableStart="@drawable/gender_icon"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/white"
            android:id="@+id/register_select_gender"
            android:background="@drawable/btn_custom"
            android:layout_width="150sp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:text="@string/select_gender"
            android:textAllCaps="false"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50sp"
        android:weightSum="2">
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/white"
            android:id="@+id/register_back_btn"
            android:background="@drawable/btn_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="50sp"
            android:text="@string/back"
            android:layout_weight="0"
            android:textAllCaps="false"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/white"
            android:id="@+id/register_btn"
            android:background="@drawable/btn_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
