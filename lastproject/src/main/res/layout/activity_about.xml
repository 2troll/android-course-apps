<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/wallpaper1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="35sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20sp"
        android:text="@string/about"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="90sp"
        android:layout_marginTop="15sp"
        android:text="@string/about_store_info"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/trans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35sp">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/trans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="63sp">
            <ImageView
                android:id="@+id/aboutfacebook"
                android:layout_width="90sp"
                android:layout_height="90sp"
                app:srcCompat="@drawable/facebook_logo"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/trans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="110sp">
            <ImageView
                android:id="@+id/aboutinstagram"
                android:layout_width="90sp"
                android:layout_height="90sp"
                app:srcCompat="@drawable/instagram_logo"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/trans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50sp">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/trans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="63sp">
            <ImageView
                android:id="@+id/aboutwaze"
                android:layout_width="90sp"
                android:layout_height="90sp"
                app:srcCompat="@drawable/waze_logo"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/trans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="110sp">
            <ImageView
                android:id="@+id/aboutphone"
                android:layout_width="90sp"
                android:layout_height="90sp"
                app:srcCompat="@drawable/phone_img"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/trans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50sp">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/trans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="63sp">
            <ImageView
                android:id="@+id/aboutsms"
                android:layout_width="90sp"
                android:layout_height="90sp"
                app:srcCompat="@drawable/sms_img"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/trans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="110sp">
            <ImageView
                android:id="@+id/aboutemail"
                android:layout_width="90sp"
                android:layout_height="90sp"
                app:srcCompat="@drawable/email_img"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/aboutback"
        android:background="@drawable/btn_custom"
        android:layout_width="150sp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="35sp"
        android:layout_marginTop="50sp"
        android:text="@string/back"
        android:textAllCaps="false"/>
</LinearLayout>
