<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/wallpaper1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="30sp"
        android:textColor="#c5c6c7"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15sp"
        android:text="@string/profile"/>
    <ImageView
        android:id="@+id/pr_Image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp"
        app:srcCompat="@drawable/login"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/click_to_change_profile_photo"/>
    <EditText
        android:textSize="15sp"
        android:textColorHint="@color/black"
        android:id="@+id/prFName"
        android:background="@drawable/edittext_custom"
        android:padding="5sp"
        android:layout_width="match_parent"
        android:layout_height="35sp"
        android:layout_marginLeft="20sp"
        android:layout_marginTop="25sp"
        android:layout_marginRight="20sp"
        android:drawablePadding="10sp"
        android:drawableStart="@drawable/account_icon"/>
    <EditText
        android:textSize="15sp"
        android:textColorHint="@color/black"
        android:id="@+id/prUserName"
        android:background="@drawable/edittext_custom"
        android:padding="5sp"
        android:layout_width="match_parent"
        android:layout_height="35sp"
        android:layout_marginLeft="20sp"
        android:layout_marginTop="20sp"
        android:layout_marginRight="20sp"
        android:drawablePadding="10sp"
        android:drawableStart="@drawable/username_icon"/>
    <EditText
        android:textSize="15sp"
        android:textColorHint="@color/black"
        android:id="@+id/prEmail"
        android:background="@drawable/edittext_custom"
        android:padding="5sp"
        android:layout_width="match_parent"
        android:layout_height="35sp"
        android:layout_marginLeft="20sp"
        android:layout_marginTop="20sp"
        android:layout_marginRight="20sp"
        android:drawablePadding="10sp"
        android:drawableStart="@drawable/email_icon"/>
    <EditText
        android:textSize="15sp"
        android:textColorHint="@color/black"
        android:id="@+id/prPassword"
        android:background="@drawable/edittext_custom"
        android:padding="5sp"
        android:layout_width="match_parent"
        android:layout_height="35sp"
        android:layout_marginLeft="20sp"
        android:layout_marginTop="20sp"
        android:layout_marginRight="20sp"
        android:drawablePadding="10sp"
        android:inputType="textPassword"
        android:drawableStart="@drawable/lock_icon"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2">
        <EditText
            android:textSize="15sp"
            android:textColorHint="@color/black"
            android:id="@+id/prDate"
            android:background="@drawable/edittext_custom"
            android:padding="5sp"
            android:layout_width="170sp"
            android:layout_height="35sp"
            android:layout_marginLeft="20sp"
            android:layout_marginTop="20sp"
            android:layout_marginRight="20sp"
            android:drawablePadding="10sp"
            android:layout_weight="1.7"
            android:drawableStart="@drawable/date_icon"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/white"
            android:id="@+id/pr_select_date"
            android:background="@drawable/btn_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:text="@string/select_date"
            android:textAllCaps="false"/>
    </LinearLayout>
    <EditText
        android:textSize="15sp"
        android:textColorHint="@color/black"
        android:id="@+id/prPhoneNumber"
        android:background="@drawable/edittext_custom"
        android:padding="5sp"
        android:layout_width="match_parent"
        android:layout_height="35sp"
        android:layout_marginLeft="20sp"
        android:layout_marginTop="20sp"
        android:layout_marginRight="20sp"
        android:drawablePadding="10sp"
        android:inputType="number"
        android:drawableStart="@drawable/phone_icon"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2">
        <EditText
            android:textSize="15sp"
            android:textColorHint="@color/black"
            android:id="@+id/prGender"
            android:background="@drawable/edittext_custom"
            android:padding="5sp"
            android:layout_width="170sp"
            android:layout_height="35sp"
            android:layout_marginLeft="20sp"
            android:layout_marginTop="20sp"
            android:layout_marginRight="20sp"
            android:drawablePadding="10sp"
            android:layout_weight="1.7"
            android:drawableStart="@drawable/gender_icon"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/white"
            android:id="@+id/pr_select_gender"
            android:background="@drawable/btn_custom"
            android:layout_width="150sp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:text="@string/select_gender"
            android:textAllCaps="false"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="30sp"
        android:weightSum="2">
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/white"
            android:id="@+id/pr_update_button"
            android:background="@drawable/btn_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
