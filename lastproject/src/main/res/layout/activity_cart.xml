<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/wallpaper1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="30sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cart"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20sp">
        <TextView
            android:gravity="center"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:text="@string/price"/>
        <TextView
            android:gravity="center"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/pic"/>
        <TextView
            android:gravity="center"
            android:background="@color/white"
            android:layout_width="180sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/product_name"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp">
        <TextView
            android:gravity="center"
            android:id="@+id/picts1"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:text="@string/zero_price"/>
        <TextView
            android:gravity="center"
            android:id="@+id/pict1"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/zero_pieces"/>
        <TextView
            android:gravity="center"
            android:background="@color/white"
            android:layout_width="180sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/strawberry_daifuku_mochi"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp">
        <TextView
            android:gravity="center"
            android:id="@+id/picts2"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:text="@string/zero_price"/>
        <TextView
            android:gravity="center"
            android:id="@+id/pict2"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/zero_pieces"/>
        <TextView
            android:gravity="center"
            android:background="@color/white"
            android:layout_width="180sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/fruit_roll_cake"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp">
        <TextView
            android:gravity="center"
            android:id="@+id/picts3"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:text="@string/zero_price"/>
        <TextView
            android:gravity="center"
            android:id="@+id/pict3"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/zero_pieces"/>
        <TextView
            android:gravity="center"
            android:background="@color/white"
            android:layout_width="180sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/dango"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp">
        <TextView
            android:gravity="center"
            android:id="@+id/picts4"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:text="@string/zero_price"/>
        <TextView
            android:gravity="center"
            android:id="@+id/pict4"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/zero_pieces"/>
        <TextView
            android:gravity="center"
            android:background="@color/white"
            android:layout_width="180sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/taiyaki"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp">
        <TextView
            android:gravity="center"
            android:id="@+id/picts5"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:text="@string/zero_price"/>
        <TextView
            android:gravity="center"
            android:id="@+id/pict5"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/zero_pieces"/>
        <TextView
            android:gravity="center"
            android:background="@color/white"
            android:layout_width="180sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/matcha_cake_with_red_beans"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp">
        <TextView
            android:gravity="center"
            android:id="@+id/picts6"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:text="@string/zero_price"/>
        <TextView
            android:gravity="center"
            android:id="@+id/pict6"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/zero_pieces"/>
        <TextView
            android:gravity="center"
            android:background="@color/white"
            android:layout_width="180sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/wagashi"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25sp">
        <TextView
            android:gravity="center"
            android:id="@+id/totalprice"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:text="@string/zero_price"/>
        <TextView
            android:gravity="center"
            android:id="@+id/totalpic"
            android:background="@color/white"
            android:layout_width="70sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/zero_pieces"/>
        <TextView
            android:gravity="center"
            android:background="@color/white"
            android:layout_width="180sp"
            android:layout_height="50sp"
            android:layout_marginLeft="15sp"
            android:text="@string/total"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25sp"
        android:weightSum="1">
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/white"
            android:id="@+id/CartPickTime"
            android:background="@drawable/btn_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pick_time"
            android:layout_weight="0.3"
            android:textAllCaps="false"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/white"
            android:id="@+id/CartPickDate"
            android:background="@drawable/btn_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15sp"
            android:text="@string/pick_date"
            android:layout_weight="0.3"
            android:textAllCaps="false"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp"
        android:weightSum="1">
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/white"
            android:id="@+id/CartCheckout"
            android:background="@drawable/btn_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checkout"
            android:layout_weight="0.8"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
